{
  "name": "msp-status-hud",
  "version": "3.3.6",
  "private": true,
  "description": "Enterprise first-party MSP service intelligence and live operations workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "update-status:raw": "node --experimental-strip-types scripts/update-public-status.mjs",
    "ensure-valid-status": "node scripts/ensure-valid-status.mjs",
    "emit-status-contract": "node --experimental-strip-types scripts/emit-status-contract.mjs public/status.json",
    "update-status": "npm run update-status:raw && npm run ensure-valid-status && npm run emit-status-contract",
    "sync-provider-favicons": "node scripts/sync-provider-favicons.mjs",
    "validate-providers": "node scripts/validate-providers.mjs && node --experimental-strip-types scripts/validate-canonical-providers.mjs",
    "lint": "node scripts/source-quality.mjs",
    "format:check": "node scripts/format-check.mjs",
    "quality": "npm run lint && npm run format:check",
    "hooks:install": "node scripts/configure-git-hooks.mjs",
    "test": "node --import ./scripts/__tests__/test-clock.mjs --test --experimental-strip-types src/__tests__/*.test.ts scripts/__tests__/*.test.js",
    "test:watch": "node --import ./scripts/__tests__/test-clock.mjs --test --watch --experimental-strip-types src/__tests__/*.test.ts scripts/__tests__/*.test.js",
    "typecheck": "tsc --noEmit",
    "build:app": "node scripts/write-deploy-version.mjs && npm run sync-provider-favicons && vite build",
    "validate-browser-payload": "node --experimental-strip-types scripts/validate-browser-payload.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
