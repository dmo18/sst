{
  "name": "msp-status-hud",
  "version": "3.3.1",
  "private": true,
  "description": "Enterprise first-party MSP service intelligence and live operations workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate-providers && npm test && npm run typecheck && vite build",
    "build:app": "vite build",
    "test": "node --test scripts/__tests__/*.test.js",
    "typecheck": "tsc --noEmit",
    "update-status": "node scripts/update-public-status.mjs",
    "validate-providers": "node scripts/validate-providers.mjs",
    "validate-browser-payload": "node scripts/validate-browser-payload.mjs",
    "validate-coverage": "node scripts/validate-live-coverage.mjs",
    "generate-release-notes": "node scripts/generate-release-notes.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
